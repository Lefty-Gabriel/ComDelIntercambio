# =============================================================================
# Traction - variables de entorno
# Copia este archivo a .env y completa los valores.
# Los valores de Supabase local salen de: npm run db:status
# =============================================================================

# --- Backend (apps/api) ---
NODE_ENV=development
PORT=3000

# Supabase (proyecto local levantado con `npm run db:start`)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Explicit test accounts: npm run seed:test-users
# Generated passwords are saved privately in .env.seed.local (JSON, gitignored).

# Conexion directa a Postgres (Supabase local)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- Frontend (apps/web) ---
# Vite solo expone variables con prefijo VITE_
VITE_API_URL=http://localhost:3000
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# Video
VIDEO_RETENTION_DAYS=180

